# Supabase connection. Copy this file to .env, fill it in, then restart `npm run dev`.
# Find both values in the Supabase dashboard: Project Settings -> API Keys.

# Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Safe for the browser; access is controlled by RLS policies.
# Legacy projects can use the old "anon" key in SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Do NOT put a secret / service_role key here. Only the variables above are ever sent to the browser.
